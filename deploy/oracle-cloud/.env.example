# Public hostname that points at the VM (an A record). Caddy obtains HTTPS automatically.
DEPLOY_DOMAIN=study.example.com

ENVIRONMENT=production
DEBUG=false
DATA_DIR=/app/data

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-value

# Generate with: openssl rand -hex 24
BETA_ADMIN_KEY=replace-with-a-different-long-random-value

# Beta access control
BETA_INVITE_ONLY=true
ALLOW_ANONYMOUS_SESSIONS=false

# Leave empty to use SQLite under /app/data.
# DATABASE_URL=

# Optional AI provider
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional invite email delivery
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Study Companion <you@example.com>

# Optional registration/feedback guide
# REGISTRATION_DOC_URL=https://docs.google.com/document/d/.../edit

# Upload limit in MB
MAX_FILE_SIZE_MB=50
