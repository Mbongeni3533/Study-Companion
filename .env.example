# Study Companion App - Environment Configuration
# Copy this file to .env and update values

# ==================== REQUIRED ====================
# JWT Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your-change-this-secret-key-in-production

# ==================== DATABASE ====================
# SQLite (development)
DATABASE_URL=sqlite:///./study_companion.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost/study_companion

# ==================== AI PROVIDERS ====================
# Claude API (optional - fallback to rule-based responses)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# GOOGLE_API_KEY=your-palm-api-key-here

# ==================== PAYMENTS ====================
STRIPE_SECRET_KEY=sk_test_your-stripe-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ==================== FILE STORAGE ====================
# S3 Bucket for production (optional)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET=study-companion-files
AWS_REGION=us-east-1

# ==================== APP SETTINGS ====================
MAX_FILE_SIZE_MB=50
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_PER_MINUTE=60

# ==================== REDIS (for BullMQ jobs) ====================
REDIS_URL=redis://localhost:6379/0