# Study Companion App - Environment Configuration
# Copy this file to .env and update values. Everything below has a working
# development default except the AI provider, which is optional.

# ==================== REQUIRED IN PRODUCTION ====================
# JWT signing secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-to-a-random-32-byte-secret

# ==================== DATABASE ====================
# SQLite (development, created automatically)
# DATABASE_URL=sqlite:///./data/study_companion.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost/study_companion

# ==================== AI PROVIDER (OPTIONAL) ====================
# Without a key the app uses its built-in rule-based coach: topic quizzes,
# graduated hints and plan generation all still work.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=1200

# ==================== PAYMENTS (PHASE 3, OPTIONAL) ====================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==================== APP SETTINGS ====================
# 30 days
ACCESS_TOKEN_EXPIRE_MINUTES=43200
MAX_FILE_SIZE_MB=50
DEFAULT_DAILY_STUDY_MINUTES=60
# Comma separated origins, or * for the bundled client
CORS_ORIGINS=*

# ==================== FILE STORAGE ====================
# Uploads are written to DATA_DIR/uploads. Point DATA_DIR at a mounted volume
# in production, or swap in S3-compatible storage.
# DATA_DIR=./data

# ==================== OCR (SCANNED PDFs / IMAGES) ====================
# Scanned PDFs have no text layer; OCR reads the page images instead.
# Needs the optional deps from requirements.txt (pypdfium2 + rapidocr-onnxruntime,
# or a system tesseract install). Set OCR_ENABLED=false to skip OCR entirely.
OCR_ENABLED=true
# Page budget per document - OCR costs roughly 2-6s per page.
OCR_MAX_PAGES=25
OCR_DPI=150
