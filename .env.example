# Study Companion App - Environment Configuration
# Copy this file to .env and update values. Everything below has a working
# development default except the AI provider, which is optional.

# ==================== REQUIRED IN PRODUCTION ====================
# JWT signing secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-to-a-random-32-byte-secret

# ==================== DATABASE ====================
# SQLite (development, created automatically)
# DATABASE_URL=sqlite:///./data/study_companion.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost/study_companion

# ==================== AI PROVIDER (OPTIONAL) ====================
# Without a key the app uses its built-in rule-based coach: topic quizzes,
# graduated hints and plan generation all still work.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Coach model calls go through the local Respan gateway (see README).
# Leave empty for api.anthropic.com; set it to point the gateway at a local
# fixture or an already-authorized endpoint.
ANTHROPIC_BASE_URL=
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=1200

# ==================== PAYMENTS (OPTIONAL) ====================
# With a secret key and price ID, Settings shows Stripe Checkout. Without them,
# registered beta users can activate the Plus plan from Settings themselves.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Public origin used for Stripe success/cancel URLs.
PUBLIC_APP_URL=https://study-companion-o7k3.onrender.com
ALLOW_BETA_SELF_ACTIVATION=true

# ==================== TRANSACTIONAL EMAIL (OPTIONAL) ====================
# Used for beta invites and subscription confirmations. Without a key, emails
# are skipped and the rest of the app keeps working.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Study Companion <onboarding@resend.dev>
# Comma-separated addresses that receive subscriber, billing and operational
# alerts (failed documents, stale processing and system-health problems).
ADMIN_NOTIFICATION_EMAIL=
# Background operational-alert check interval. Requires RESEND_API_KEY and at
# least one ADMIN_NOTIFICATION_EMAIL address.
ADMIN_NOTIFICATION_INTERVAL_MINUTES=15

# ==================== APP SETTINGS ====================
# 30 days
ACCESS_TOKEN_EXPIRE_MINUTES=43200
MAX_FILE_SIZE_MB=50
DEFAULT_DAILY_STUDY_MINUTES=60
# Comma separated origins, or * for the bundled client
CORS_ORIGINS=*

# ==================== FILE STORAGE ====================
# Uploads are written to DATA_DIR/uploads. Point DATA_DIR at a mounted volume
# in production, or swap in S3-compatible storage.
# DATA_DIR=./data

# ==================== OCR (SCANNED PDFs / IMAGES) ====================
# Scanned PDFs have no text layer; OCR reads the page images instead.
# Needs the optional deps from requirements.txt (pypdfium2 + rapidocr-onnxruntime,
# or a system tesseract install). Set OCR_ENABLED=false to skip OCR entirely.
OCR_ENABLED=true

# Minutes without document-processing progress before the admin remediation
# agent may mark a document failed. Failed documents are left for manual review.
STALE_PROCESSING_MINUTES=60
# System-health capacity checks. Each check warns when database or upload
# storage exceeds this size, or grows by this much over a rolling seven days.
STORAGE_WARNING_MB=1024
STORAGE_GROWTH_WARNING_MB=100
# Page budget per document - OCR costs roughly 2-6s per page.
OCR_MAX_PAGES=25
OCR_DPI=150
